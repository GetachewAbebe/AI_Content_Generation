{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Heritage Short storyboard: the contract between every stage",
 "type":"object","additionalProperties":false,
 "required":["version","title","language","logline","audience","intent","duration_s","style_block","characters","references","providers","shots","music","mix","end_card"],
 "properties":{
  "version":{"const":1},
  "title":{"type":"object","additionalProperties":false,"required":["native","en"],"properties":{"native":{"$ref":"#/$defs/text"},"en":{"$ref":"#/$defs/text"}}},
  "language":{"type":"object","additionalProperties":false,"required":["code","name"],"properties":{"code":{"type":"string","pattern":"^[a-z]{2,3}$"},"name":{"$ref":"#/$defs/text"}}},
  "logline":{"$ref":"#/$defs/text"},"audience":{"$ref":"#/$defs/text"},"intent":{"$ref":"#/$defs/text"},
  "duration_s":{"type":"object","additionalProperties":false,"required":["min","max"],"properties":{"min":{"type":"number","minimum":60},"max":{"type":"number","maximum":90}}},
  "style_block":{"$ref":"#/$defs/text"},
  "negative_prompt":{"type":"string"},
  "characters":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","description","real_person"],
    "properties":{"id":{"$ref":"#/$defs/id"},"description":{"$ref":"#/$defs/text"},"real_person":{"type":"boolean"},"consent_id":{"type":"string"}},
    "if":{"properties":{"real_person":{"const":true}}},"then":{"required":["consent_id"]}}},
  "references":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","kind","prompt","seed"],
    "properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["character","style","place","object"]},"prompt":{"$ref":"#/$defs/text"},"seed":{"$ref":"#/$defs/seed"},"characters":{"type":"array","items":{"$ref":"#/$defs/id"}},"references":{"type":"array","maxItems":3,"items":{"$ref":"#/$defs/id"}}}}},
  "providers":{"type":"object","additionalProperties":false,"required":["tts","image","video","music"],"properties":{
    "tts":{"type":"object","additionalProperties":false,"required":["model","voice","style"],"properties":{"model":{"type":"string"},"voice":{"type":"string"},"style":{"$ref":"#/$defs/text"}}},
    "image":{"type":"object","additionalProperties":false,"required":["model","steps"],"properties":{"model":{"type":"string"},"steps":{"type":"integer","minimum":1,"maximum":50}}},
    "video":{"type":"object","additionalProperties":false,"required":["model","long_side","short_side","num_frames","fps","steps","guidance","flow_shift"],"properties":{
      "model":{"type":"string"},"long_side":{"type":"integer","multipleOf":32},"short_side":{"type":"integer","multipleOf":32},"num_frames":{"type":"integer","minimum":17,"maximum":121},"fps":{"const":24},"steps":{"type":"integer","minimum":4},"guidance":{"type":"number"},"flow_shift":{"type":"number"}}},
    "music":{"type":"object","additionalProperties":false,"required":["model","steps"],"properties":{"model":{"type":"string"},"steps":{"type":"integer","minimum":1,"maximum":20}}}}},
  "shots":{"type":"array","minItems":8,"maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["id","reason","shot_size","min_duration_s","keyframe","motion","narration"],
    "properties":{
     "id":{"$ref":"#/$defs/id"},"reason":{"$ref":"#/$defs/text"},
     "shot_size":{"enum":["extreme_wide","wide","medium","medium_close_up","close_up","extreme_close_up","insert"]},
     "min_duration_s":{"type":"number","minimum":2,"maximum":12},
     "keyframe":{"type":"object","additionalProperties":false,"required":["prompt","seed","references","characters"],"properties":{"prompt":{"$ref":"#/$defs/text"},"seed":{"$ref":"#/$defs/seed"},"references":{"type":"array","maxItems":3,"items":{"$ref":"#/$defs/id"}},"characters":{"type":"array","items":{"$ref":"#/$defs/id"}}}},
     "motion":{"type":"object","additionalProperties":false,"required":["backend","prompt","seed","kenburns"],"properties":{"backend":{"enum":["wan","kenburns"]},"prompt":{"$ref":"#/$defs/text"},"seed":{"$ref":"#/$defs/seed"},"kenburns":{"enum":["push_in","pull_out","pan_left","pan_right","tilt_up","tilt_down"]},"why_backend":{"type":"string"}}},
     "narration":{"type":"object","additionalProperties":false,"required":["text","subtitle_en"],"properties":{"text":{"type":"string"},"subtitle_en":{"type":"string"},"style":{"type":"string"},"take":{"type":"integer","minimum":1}}}}}},
  "music":{"type":"object","additionalProperties":false,"required":["cues"],"properties":{"cues":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,
    "required":["id","start_shot","purpose","caption","bpm","keyscale","duration_s","seeds","chosen_seed"],
    "properties":{"id":{"$ref":"#/$defs/id"},"start_shot":{"$ref":"#/$defs/id"},"purpose":{"$ref":"#/$defs/text"},"caption":{"type":"string","minLength":3,"maxLength":512},"bpm":{"type":"integer","minimum":30,"maximum":200},"keyscale":{"type":"string"},"duration_s":{"type":"number","minimum":10,"maximum":120},"seeds":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"$ref":"#/$defs/seed"}},"chosen_seed":{"$ref":"#/$defs/seed"},"why_chosen":{"type":"string"}}}}}},
  "mix":{"type":"object","additionalProperties":false,"required":["target_lufs","true_peak_db","narration_lufs","music_lufs","duck","head_pad_s","tail_pad_s"],"properties":{
    "target_lufs":{"type":"number"},"true_peak_db":{"type":"number","maximum":-1},"narration_lufs":{"type":"number"},"music_lufs":{"type":"number"},
    "duck":{"type":"object","additionalProperties":false,"required":["threshold","ratio","attack_ms","release_ms"],"properties":{"threshold":{"type":"number"},"ratio":{"type":"number"},"attack_ms":{"type":"number"},"release_ms":{"type":"number"}}},
    "head_pad_s":{"type":"number","minimum":0},"tail_pad_s":{"type":"number","minimum":0},"snap_to_beat":{"type":"boolean"}}},
  "end_card":{"type":"object","additionalProperties":false,"required":["duration_s","lines"],"properties":{"duration_s":{"type":"number","minimum":2,"maximum":5},"lines":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}}}}
 },
 "$defs":{"text":{"type":"string","minLength":3},"id":{"type":"string","pattern":"^[a-z0-9_]+$"},"seed":{"type":"integer","minimum":0,"maximum":2147483647}}
}
